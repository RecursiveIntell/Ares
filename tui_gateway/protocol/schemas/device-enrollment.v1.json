{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ares.local/protocol/device-enrollment.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["challenge_id", "host_id", "expires_at", "requested_scopes"],
  "properties": {
    "challenge_id": {"type": "string", "minLength": 1},
    "host_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expires_at": {"type": "number"},
    "requested_scopes": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 96}
    }
  }
}