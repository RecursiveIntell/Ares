+                if calls.get() == 1 {
+                    now()
+                } else {
+                    final_time
+                }
+            })
+            .is_err());
+        assert_eq!(calls.get(), 2);
+        assert_eq!(store.state(&permit.permit_id)?.state, PermitStateV1::Issued);
+    }
+    Ok(())
+}
